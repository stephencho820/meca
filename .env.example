# Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Never prefix the service role key with NEXT_PUBLIC_.
# Not required: public bookings use a narrow, validated DB RPC.
# SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 알림톡 시스템 (server-only; 절대 NEXT_PUBLIC_ 사용 금지)
# SOLAPI 가입 / 카카오 비즈니스 채널 연결 / 각 알림톡 템플릿 승인 후 기입
SUPABASE_SERVICE_ROLE_KEY=
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_REQUESTED=
SOLAPI_TEMPLATE_CONFIRMED=
SOLAPI_TEMPLATE_RESCHEDULED=
SOLAPI_TEMPLATE_CANCELLED=
SOLAPI_TEMPLATE_REMINDER=
MECA_NOTIFICATIONS_ENABLED=false
CRON_SECRET=

# Optional Cloudflare Turnstile: configure both in Vercel production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
